<Window x:Class="ChernobylZLauncher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Chernobyl Z"
        Width="1180" Height="720"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0d0f10">

    <!-- sin barra de windows, pero con bordes para cambiar el tamano -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="#0d0f10">
        <!-- margen de 4 px para que el borde de resize no lo tape el webview -->
        <wv2:WebView2 x:Name="WebView" Margin="4" />
    </Grid>
</Window>